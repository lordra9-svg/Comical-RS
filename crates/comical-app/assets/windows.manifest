<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest embedded into comical.exe by build.rs.

  - asInvoker: the viewer never needs elevation, and asking for it would make
    Windows show a UAC prompt on every launch.
  - permonitorv2: correct scaling when the window moves between monitors with
    different DPI.
  - supportedOS: declares Windows 10 and 11 so version APIs do not lie.
  - longPathAware: comic libraries live in deep directory trees.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    type="win32"
    name="Comical"
    version="1.0.0.0"
    processorArchitecture="amd64"/>
  <description>Desktop comic book reader</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 share this GUID. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
