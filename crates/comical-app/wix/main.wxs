<?xml version='1.0' encoding='windows-1252'?>
<!--
  Windows Installer XML (WiX) configuration for Comical.
  Generated by cargo-wix. Customize as needed.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='Comical'
    UpgradeCode='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'
    Manufacturer='Comical-RS Contributors'
    Language='1033'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package Id='*'
      Keywords='Installer'
      Description='Desktop comic book reader'
      Comments='Supports CBZ, CBR and 7z archives'
      Manufacturer='Comical-RS Contributors'
      InstallerVersion='450'
      Languages='1033'
      Compressed='yes'
      SummaryCodepage='1252'
      Platform='x64'/>

    <Media Id='1' Cabinet='Comical.cab' EmbedCab='yes' />

    <MajorUpgrade
      DowngradeErrorMessage='A newer version of [ProductName] is already installed.'
      Schedule='afterInstallInitialize'/>

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='APPLICATIONFOLDER' Name='Comical'>
          <Component Id='MainExecutable' Guid='B2C3D4E5-F6A7-8901-BCDE-F12345678901' Win64='yes'>
            <File Id='ComicalEXE' Name='comical.exe' DiskId='1' Source='target/x86_64-pc-windows-msvc/release/comical.exe' KeyPath='yes'/>
          </Component>

          <!-- File associations for comic archive formats -->
          <Component Id='FileAssociations' Guid='C3D4E5F6-A7B8-9012-CDEF-123456789012' Win64='yes'>
            <RegistryValue Root='HKCR' Key='Comical.CBZ' Type='string' Value='Comic Book ZIP Archive' KeyPath='yes'/>
            <RegistryValue Root='HKCR' Key='Comical.CBZ\DefaultIcon' Type='string' Value='[#ComicalEXE],0'/>
            <RegistryValue Root='HKCR' Key='Comical.CBZ\shell\open\command' Type='string' Value='"[#ComicalEXE]" "%1"'/>
            
            <RegistryValue Root='HKCR' Key='Comical.CBR' Type='string' Value='Comic Book RAR Archive'/>
            <RegistryValue Root='HKCR' Key='Comical.CBR\DefaultIcon' Type='string' Value='[#ComicalEXE],0'/>
            <RegistryValue Root='HKCR' Key='Comical.CBR\shell\open\command' Type='string' Value='"[#ComicalEXE]" "%1"'/>
            
            <RegistryValue Root='HKCR' Key='Comical.CB7' Type='string' Value='Comic Book 7z Archive'/>
            <RegistryValue Root='HKCR' Key='Comical.CB7\DefaultIcon' Type='string' Value='[#ComicalEXE],0'/>
            <RegistryValue Root='HKCR' Key='Comical.CB7\shell\open\command' Type='string' Value='"[#ComicalEXE]" "%1"'/>
            
            <!-- Register extensions -->
            <RegistryValue Root='HKCR' Key='.cbz' Type='string' Value='Comical.CBZ'/>
            <RegistryValue Root='HKCR' Key='.cbr' Type='string' Value='Comical.CBR'/>
            <RegistryValue Root='HKCR' Key='.cb7' Type='string' Value='Comical.CB7'/>
          </Component>

          <!-- Start Menu shortcut -->
          <Component Id='StartMenuShortcut' Guid='D4E5F6A7-B8C9-0123-DEF0-234567890123' Win64='yes'>
            <Shortcut Id='StartMenuComical' Name='Comical' Target='[#ComicalEXE]' WorkingDirectory='APPLICATIONFOLDER'/>
            <RegistryValue Root='HKCU' Key='Software\Comical-RS\Comical' Name='StartMenuShortcut' Type='integer' Value='1' KeyPath='yes'/>
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id='Complete' Title='Comical' Description='The complete application' Display='expand' Level='1'>
      <ComponentRef Id='MainExecutable'/>
      <ComponentRef Id='FileAssociations'/>
      <ComponentRef Id='StartMenuShortcut'/>
    </Feature>

    <UIRef Id='WixUI_Minimal'/>
    <UIRef Id='WixUI_ErrorProgressText'/>

    <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
  </Product>
</Wix>